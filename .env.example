# Copy to .env.local for local development. Never commit real values.
# On Vercel these are set in Project Settings > Environment Variables.

# Neon. Set automatically by the Vercel Marketplace integration.
DATABASE_URL=postgres://user:password@localhost:5432/roundtable
DATABASE_URL_UNPOOLED=postgres://user:password@localhost:5432/roundtable

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend. Leave RESEND_API_KEY empty locally and sign-in codes print to the terminal.
RESEND_API_KEY=
EMAIL_FROM="Roundtable Tools <no-reply@mail.example.com>"

# Emails that may claim admin when no admin exists yet. Comma-separated.
BOOTSTRAP_ADMIN_EMAILS=

# Production only: run database migrations during the build.
RUN_MIGRATIONS=false
